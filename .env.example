# Database (required) — `bun run db:up` starts a matching local Postgres
DATABASE_URL=postgresql://cinder:cinder@localhost:5432/cinder

# Auth (Better Auth)
BETTER_AUTH_SECRET=<random-secret-for-sessions>   # e.g. `openssl rand -base64 32`
BETTER_AUTH_URL=http://localhost:3000
# Google sign-in. Optional for local development when CINDER_DEV_AUTH=true.
GOOGLE_CLIENT_ID=<oauth-client-id>
GOOGLE_CLIENT_SECRET=<oauth-client-secret>
# Extra origins allowed to call the auth API (comma-separated). The Vite dev
# origin http://localhost:5173 is trusted automatically when CINDER_DEV_AUTH=true.
# BETTER_AUTH_TRUSTED_ORIGINS=

# Local development only: enables email/password sign-in on the sign-in page.
# Ignored when NODE_ENV=production.
# CINDER_DEV_AUTH=true

# Generic FHIR server projects (HAPI, etc.) are only allowed for these hostnames
# (comma-separated, or * for any). Unset = only Google Cloud Healthcare projects.
# CINDER_ALLOWED_FHIR_HOSTS=localhost

# Encryption (for service account storage; only needed for GCP projects)
CINDER_ENCRYPTION_KEY=<32-byte-base64-master-key>
CINDER_ENCRYPTION_KEY_VERSION=1

# DEPRECATED: replaced by GOOGLE_CLIENT_ID (server-side)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# DEPRECATED: GCP coordinates now live on projects, not in env
# VITE_GCP_PROJECT=your-gcp-project
# VITE_GCP_LOCATION=us-central1
# VITE_GCP_DATASET=your-dataset
# VITE_GCP_FHIR_STORE=your-fhir-store
